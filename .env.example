# Copy to .env and fill in what you need. Everything is optional.

# ---- server ----
PORT=8787
# 0.0.0.0 opens the server to the network - then also set ADMIN_TOKEN.
HOST=127.0.0.1
# Protects /admin and /api/admin/*: open /admin?token=... in the browser.
# Without it the panel only works from this machine (localhost). If HOST is not a loopback
# address and ADMIN_TOKEN is empty, the server makes up a random token and prints the link.
ADMIN_TOKEN=
# Extra host names that may use the panel without a token (e.g. this Mac's LAN name).
ALLOWED_HOSTS=
# interactive | tv (can be switched live in /admin)
MODE=interactive
# Full day/night cycle of the tank in minutes (30 for demos, 120+ for 24/7 streams).
DAY_LENGTH_MIN=30
POPULATION_CAP=140

# ---- YouTube live chat (YouTube Data API v3) ----
YOUTUBE_API_KEY=
# The live stream video id (or paste the stream link in /admin instead).
YOUTUBE_VIDEO_ID=
# OAuth instead of an API key (also lets the server find your active broadcast by itself):
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Your project's daily quota; polling is paced so it never runs out before midnight Pacific.
YOUTUBE_DAILY_QUOTA=10000
# Force a fixed poll interval in ms (ignores quota pacing). 0 = automatic.
YOUTUBE_MIN_POLL_MS=0

# ---- AI parser for free-form requests (Claude) ----
ANTHROPIC_API_KEY=
# auto (on when a key is set) | on | off
AI_PARSER=auto
AI_MODEL=claude-opus-5
AI_DAILY_BUDGET_USD=3
AI_MAX_CALLS_PER_MIN=12

# ---- autonomous life ----
AUTO_FEED_MIN=25
TV_AUTO_FEED_MIN=20
GOLDEN_MEAN_MIN=150
NIGHT_JELLY_MEAN_MIN=45
BIRTHS_PER_DAY=2

# Start the fake audience on boot: calm | normal | busy
SIM_AUTOSTART=
